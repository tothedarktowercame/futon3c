;; Control for futon3c.diagramprover.wiring/conformance, pinned with the
;; checker at c474470f (before var-grain sites, the read/write heuristic and
;; the load-closure check). Sites are futon2's files AT :futon2-sha, which the
;; test materialises from git into a temp root, so futon2 moving does not move
;; the control. :report is holes/labs/M-diagramprover/wm-wiring.edn as is;
;; :perturbed-report adds one absent write to :belief-model and one
;; universe-only reader of :selection-law, so the control is not only [].
{:computed-by "futon3c.diagramprover.wiring/conformance at c474470f (claude-11, 2026-09-25)"
 :spec "holes/labs/M-diagramprover/wm-wiring.edn"
 :futon2-sha "e1f6d9096a3820259405230613f1e5fe2e72a970"
 :site-paths ["src/futon2/aif/belief.clj"
              "scripts/futon2/report/war_machine.clj"
              "test/futon2/aif/a_matrix_live_wiring_test.clj"]
 :report []
 ;; Pinned 2026-09-25 after the map's :likelihood-mode direction was corrected
 ;; (DIAGRAMPROVER-WIRING-I2): conformance {:heuristic? true} over the same
 ;; sites. The correction leaves :report and :perturbed-report unchanged: the
 ;; default run checks occurrence only, and :likelihood-mode occurs at both
 ;; its declared sites either way. Before the correction the heuristic also
 ;; reported :declared-write-not-found on :belief-model and
 ;; :declared-read-not-found on :war-machine-report for :likelihood-mode.
 :heuristic-report
 [{:finding :declared-read-not-found, :box/id :a-matrix-live-wiring-test,
   :field :initial-prior-hash, :role :reads,
   :site {:file "test/futon2/aif/a_matrix_live_wiring_test.clj"},
   :usage {:reads 0, :writes 0, :unclassified 1}, :heuristic true}
  {:finding :declared-read-not-found, :box/id :a-matrix-live-wiring-test,
   :field :observation-model-hash, :role :reads,
   :site {:file "test/futon2/aif/a_matrix_live_wiring_test.clj"},
   :usage {:reads 0, :writes 0, :unclassified 1}, :heuristic true}
  {:finding :declared-read-not-found, :box/id :a-matrix-live-wiring-test,
   :field :transition-model-hash, :role :reads,
   :site {:file "test/futon2/aif/a_matrix_live_wiring_test.clj"},
   :usage {:reads 0, :writes 0, :unclassified 1}, :heuristic true}]
 :perturbed-report
 [{:finding :declaration-without-occurrence, :box/id :belief-model,
   :field :model-manifest-absent, :role :writes, :site {:ns "futon2.aif.belief"}}
  {:finding :occurrence-without-declaration, :field :selection-law,
   :site {:file "scripts/futon2/report/war_machine.clj"}, :declared-by []}]}

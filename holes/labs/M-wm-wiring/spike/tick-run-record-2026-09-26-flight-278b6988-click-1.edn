on3/library/sidecar/explicit-promotion-to-facts.flexiarg", :sha256 "adf92965b95ce5487a2d0a50654d531ff13a4c9ab67bb86aed3045277cccefeb"}, :kind :machine-requested, :scope-limit "The pattern does not cover clause 2 (single-active: switch, never stack). The sidecar promotes into a set of facts and has no rule for one fact replacing another. The pattern's promotion is an act someone performs explicitly, not the operator's one-key confirm or hydra override. Automatic promotion that passes the gate and is logged satisfies the pattern, but only the witnessed-and-auditable half of clause 3, not the confirmable half. The 'ideally XTDB' existence witness does not carry over, and neither do the sidecar's SQLite, enum and score-bound checks.", :want :exit/h5c6933e5e2fc, :by "claude-5", :validated {:checks [:canonical-id :library-source-sha :produces-want :guard-tokens-known :owner-constraints :constructs-through-it :admitted], :candidate {:precedence [:orchestration/pattern-warranted-choice-point :sidecar/explicit-promotion-to-facts], :construction-receipt {:locator-coverage :token-set-not-supplied, :unknown-read-as-not-established [], :g-of-best {:value 23.36816913014941, :universe [:exit/h0c55648e57e5 :exit/h0f3acdf222d7 :exit/h1dae607747ce :exit/h203ce9577ebe :exit/h59adca2cd730 :exit/h5c6933e5e2fc :exit/h64ddcd0e8811 :exit/h7afd70f40a29]}, :moves [{:move-id :compose-by-need, :value 0.875, :g-comparison {:delta 0.875, :universe [:exit/h0c55648e57e5 :exit/h0f3acdf222d7 :exit/h1dae607747ce :exit/h203ce9577ebe :exit/h59adca2cd730 :exit/h5c6933e5e2fc :exit/h64ddcd0e8811 :exit/h7afd70f40a29]}, :parts {:pragmatic 0.875, :epistemic nil, :epistemic-added 0.0, :cost 0.0, :includes-unformalised-novelty false}}], :unreached-wants [{:token :exit/h0c55648e57e5, :reason :no-producer} {:token :exit/h0f3acdf222d7, :reason :no-producer} {:token :exit/h203ce9577ebe, :reason :no-producer} {:token :exit/h59adca2cd730, :reason :no-producer} {:token :exit/h64ddcd0e8811, :reason :no-producer} {:tok
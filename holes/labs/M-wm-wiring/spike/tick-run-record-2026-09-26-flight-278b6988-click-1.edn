te fulab/clock-in exists only as an @arg inside fulab/fulab-patterns.multiarg, so it has no .flexiarg path I could cite, and it concerns declaring a clock-in rather than inferring one.", :want :exit/h1dae607747ce, :by "claude-5", :validated {:checks [:canonical-id :library-source-sha :produces-want :guard-tokens-known :owner-constraints :constructs-through-it :admitted], :candidate {:precedence [:orchestration/pattern-warranted-choice-point], :construction-receipt {:locator-coverage :token-set-not-supplied, :unknown-read-as-not-established [], :g-of-best {:value 23.74316913014941, :universe [:exit/h0c55648e57e5 :exit/h0f3acdf222d7 :exit/h1dae607747ce :exit/h203ce9577ebe :exit/h59adca2cd730 :exit/h5c6933e5e2fc :exit/h64ddcd0e8811 :exit/h7afd70f40a29]}, :moves [{:move-id :compose-by-need, :value 0.5, :g-comparison {:delta 0.5, :universe [:exit/h0c55648e57e5 :exit/h0f3acdf222d7 :exit/h1dae607747ce :exit/h203ce9577ebe :exit/h59adca2cd730 :exit/h5c6933e5e2fc :exit/h64ddcd0e8811 :exit/h7afd70f40a29]}, :parts {:pragmatic 0.5, :epistemic nil, :epistemic-added 0.0, :cost 0.0, :includes-unformalised-novelty false}}], :unreached-wants [{:token :exit/h0c55648e57e5, :reason :no-producer} {:token :exit/h0f3acdf222d7, :reason :no-producer} {:token :exit/h203ce9577ebe, :reason :no-producer} {:token :exit/h59adca2cd730, :reason :no-producer} {:token :exit/h5c6933e5e2fc, :reason :no-producer} {:token :exit/h64ddcd0e8811, :reason :no-producer} {:token :exit/h7afd70f40a29, :reason :no-producer}], :coverage {:moves-taken [:compose-by-need], :final-evaluation {}}, :stop-reason :no-admitted-move, :horizon 4, :search {:expanded 9, :limit 20000}, :ordering [{:move-id :order-by-need, :before [:orchestration/pattern-warranted-choice-point], :after [:orchestration/pattern-warranted-choice-point], :status :already-ordered}], :kind :machine-constructed, :checks-added [], :no-move-findings nil, :order {:units [{:unit :orchestration/pattern-warranted-choice-point, :pattern :orchestration/pattern-w
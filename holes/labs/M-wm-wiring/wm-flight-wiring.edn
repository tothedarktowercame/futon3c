;; M-wm-wiring — component map for the flight of a lifecycle mission
;; (first target M-autoclock-in). Author claude-10, 2026-09-25, DERIVE's first
;; artefact (WM-MAP-I). Checked by futon3c.diagramprover.wiring over futon2's
;; files at :futon2-sha, materialised from git into a temp root by
;; test/futon3c/diagramprover/wm_flight_wiring_test.clj (the registered run).
;;
;; REFERENT. The sites are the code that flies: flight/run! (flight.clj:246),
;; whose production caller is flight_driver.clj:123 under --run; each click is
;; a POST to /api/alpha/wm/click that runs the tick in
;; scripts/futon2/report/war_machine.clj. N0 checks each component site
;; against a registered load closure (test-registry-307b8969, the
;; mission-reading-c8-test run, which loads the flight and the tick). The
;; earlier holes/labs/M-diagramprover/wm-wiring.edn records how close the
;; paper map came to mapping the futon3c pilot peripheral instead of the
;; futon2 War Machine; this map names futon2 files only.
;;
;; FORM. One component box per inventory row (0-11 of M-wm-wiring), plus a
;; test box per row as its declared reader. A box declares the fields the
;; WIRED code will read and write, at var grain; where the code does not do so
;; yet, the checker's finding is the row's to-do, and :expected-findings in
;; the registered test lists them exactly. Wiring a row deletes its expected
;; findings in the same commit as the code. Keys are chosen to be distinctive
;; at their site: conformance is textual (it counts comments) and direction is
;; checked only under {:heuristic? true}.
;;
;; Components outside futon2 are siteless (exempt from conformance, still in
;; the graph): the W_c checker (futon3c holes/labs/M-futon-seams/exemplar/
;; proof2a_check.clj, warranted separately, test-registry-1757d974).
{:spec/id :wm-flight-wiring
 :repos {"futon2" "8c396c3a" "futon3c" "58f1a8cb"}
 ;; The owner's text is the one constraint (exogenous: nothing on the map
 ;; writes it); the spans that locate and pin it are observations of it.
 ;; Read by futon3c.diagramprover.ct-projection (296a08ca).
 :field-roles {:owner-text :constraint :want-span :observation :text-sha256 :observation}
 :boxes
 [;; ---- row 1, Clause T: target. The field exists; the outer cascade does not.
  {:box/id :r1-target-field :row 1 :box/kind :component
   :site {:file "futon2/src/futon2/aif/target_field.clj" :var "step"}
   :writes [:next-step]}
  {:box/id :r1-outer-cascade :row 1 :box/kind :component
   :status :not-built :intended-site {:file "futon2/src/futon2/aif/outer_cascade.clj" :var "select"}
   :reads [:trigger :next-step :eligible :pair-overlap :enactment-records :publication-observed
           :clock-lineage]
   :writes [:chosen-target :draw-seed]}
  {:box/id :r1-test :row 1 :box/kind :test
   :site {:file "futon2/test/futon2/aif/outer_cascade_test.clj"}
   :reads [:draw-seed]}

  ;; ---- row 2, Clause C: the read step. Components exist; the flight does not call them.
  {:box/id :r2-served-by-reading :row 2 :box/kind :component
   :site {:file "futon2/src/futon2/aif/served_by_reading.clj" :var "proposal"}
   :reads [:owner-text] :writes [:want-span :text-sha256]}
  {:box/id :r2-verifier :row 2 :box/kind :component
   :site {:file "futon2/scripts/futon2/wm/extract_outcomes.clj" :var "verify-proposed-link"}
   :reads [:want-span :text-sha256]}
  {:box/id :r2-flight-read :row 2 :box/kind :component
   :site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "read-fn"}
   :reads [:text-sha256]}
  {:box/id :r2-test :row 2 :box/kind :test
   :site {:file "futon2/test/futon2/aif/served_by_reading_test.clj"}
   :reads [:want-span :text-sha256]}

  ;; ---- row 3, Clause C: the ask step passes the library root.
  {:box/id :r3-flight-ask :row 3 :box/kind :component
   :site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "agency-answer-fn"}
   :writes [:library-root]}
  {:box/id :r3-prompt :row 3 :box/kind :component
   :site {:file "futon2/src/futon2/aif/want_interpretation.clj" :var "prompt"}
   :reads [:library-root]}
  {:box/id :r3-test :row 3 :box/kind :test
   :site {:file "futon2/test/futon2/aif/flight_ask_library_test.clj"}
   :reads [:library-root]}

  ;; ---- row 4, Clause D: the kernel reads :order when the precedence is a linear extension.
  {:box/id :r4-constructor :row 4 :box/kind :component
   :site {:file "futon2/src/futon2/aif/construction.clj" :var "containment-order"}
   :writes [:precedence-violations :descent :units]}
  {:box/id :r4-order-use :row 4 :box/kind :component
   ;; reads the receipt's :order; called by rank-cascade-actions
   :site {:file "futon2/src/futon2/aif/efe.clj" :var "order-use"}
   :reads [:precedence-violations :descent :units]}
  {:box/id :r4-coapply :row 4 :box/kind :component
   ;; step 14: the co-application kernel, reached positionally from the
   ;; rollout (evaluate-state dispatches order-use's :kernel-step to it)
   :site {:file "futon2/src/futon2/aif/cascade_model_manifest.clj" :var "co-apply-kernel"}}
  {:box/id :r4-kernel :row 4 :box/kind :component
   :site {:file "futon2/src/futon2/aif/efe.clj" :var "rank-cascade-actions"}
   :writes [:order-use]}
  {:box/id :r4-test :row 4 :box/kind :test
   :site {:file "futon2/test/futon2/aif/order_kernel_test.clj"}
   :reads [:order-use]}
  {:box/id :r4-coapply-test :row 4 :box/kind :test
   :site {:file "futon2/test/futon2/aif/coapply_kernel_test.clj"}
   :reads [:order-use :descent :units]}

  ;; ---- rows 0, 5, 7, 9, Clause C/E: the enactment record. No writer exists (row 0).
  {:box/id :r0-enact-step :row 0 :box/kind :component
   :site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "enact-fn"}
   :reads [:candidate :enacted-steps :publication-observed] :writes [:attempts :grain-gate]}
  {:box/id :r0-test :row 0 :box/kind :test
   :site {:file "futon2/test/futon2/aif/flight_enact_test.clj"}
   :reads [:attempts :grain-gate :publication-observed]}
  {:box/id :r5-grain-gate :row 5 :box/kind :component
   :site {:file "futon2/src/futon2/aif/grain_gate.clj" :var "grain-gate"}
   :reads [:grain]}
  {:box/id :r5-flight-call :row 5 :box/kind :component
   ;; enact-fn hands the candidate's grain and the seat's planned grain to
   ;; grain-gate before the grain commit is asked for
   :site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "enact-fn"}
   :writes [:grain]}
  {:box/id :r5-test :row 5 :box/kind :test
   :site {:file "futon2/test/futon2/aif/flight_grain_gate_test.clj"}
   :reads [:grain-gate :grain :attempts]}
  {:box/id :wc-checker :box/kind :component
   ;; futon3c bb script, siteless here
   :reads [:attempts :grain-gate :candidate] :writes [:wc-verdict]}
  {:box/id :r7-increment :row 7 :box/kind :component
   :site {:file "futon2/src/futon2/aif/enactment_habit.clj" :var "increment"}
   ;; the count is decided by :wc-verdict (delta 1 only on an empty
   ;; verdict); :attempts refuses attempts outside the candidate and
   ;; :candidate is the P_c join; both are identity, not the count
   :reads [:attempts :candidate :wc-verdict] :writes [:delta :wc-failures]}
  {:box/id :r7-flight-call :row 7 :box/kind :component
   ;; the flight runs the one W_c checker (--wc --edn) and hands its verdict
   ;; to increment unchanged (step 11)
   :site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "wc-verdict-fn"}
   ;; the verdict reaches increment positionally; the flight records it under
   ;; :wc; the attempts' patterns give the policy key
   :reads [:attempts] :writes [:wc]}
  {:box/id :r7-call-test :row 7 :box/kind :test
   :site {:file "futon2/test/futon2/aif/flight_wc_call_test.clj"}
   :reads [:wc :delta :wc-failures]}
  {:box/id :r7-fold :row 7 :box/kind :component
   :site {:file "futon2/src/futon2/aif/enactment_habit.clj" :var "fold"}
   :reads [:delta] :writes [:enactment-records]}
  {:box/id :r7-selection :row 7 :box/kind :component
   :site {:file "futon2/src/futon2/aif/policy.clj" :var "select-action-cascades"}
   :reads [:enactment-records] :writes [:e-source]}
  {:box/id :r7-test :row 7 :box/kind :test
   :site {:file "futon2/test/futon2/aif/selection_reads_fold_test.clj"}
   :reads [:e-source :delta :wc-verdict]}
  {:box/id :r9-selection-law :row 9 :box/kind :component
   :site {:file "futon2/src/futon2/aif/policy.clj" :var "select-action-cascades"}
   :writes [:per-policy-argmax :candidate :enacted-steps]}
  {:box/id :r9-decision :row 9 :box/kind :component
   :site {:file "futon2/scripts/futon2/report/war_machine.clj" :var "cascade-decision-admitted"}
   ;; WM-MAP-REPLAY-I: the joint decision's typed refusal (ex-info with
   ;; :kind, defect G's writer); the relation class read at :6587 and the
   ;; :target-class it hands the class model (defect I's hop)
   :reads [:per-policy-argmax :class] :writes [:kind :target-class]}
  {:box/id :r9-test :row 9 :box/kind :test
   :site {:file "futon2/test/futon2/aif/selection_law_candidate_test.clj"}
   :reads [:candidate :per-policy-argmax :enacted-steps]}
  {:box/id :r9-judge-refusal :row 9 :box/kind :component
   ;; WM-CLICK-REFUSAL-I: the judge's typed refusal of the cascade decision,
   ;; caught at the runner's selection phase onto the :no-selection sorry cell
   :site {:file "futon2/src/futon2/aif/full_loop_runner.clj" :var "judge-refusal-sorry"}
   :writes [:judge-refusal]}
  {:box/id :r9-abstention-carrier :row 9 :box/kind :component
   ;; reads the sorry cell's :judge-refusal into abstention-carrier's branch
   :site {:file "futon2/src/futon2/aif/full_loop_runner.clj" :var "persist-run-record!"}
   :reads [:judge-refusal]}
  {:box/id :r9-judge-refusal-test :row 9 :box/kind :test
   :site {:file "futon2/test/futon2/aif/judge_refusal_abstention_test.clj"}
   :reads [:judge-refusal :kind]}
  {:box/id :r9-classify-target :row 9 :box/kind :component
   ;; WM-RELATION-I: the scoring path's relation class; an M- target with no
   ;; row derives through its stated Relations (the mission text, read by
   ;; stated-relation-path under the context's code root: :code-root is not
   ;; declared, since read-fn and cascade-decision-admitted use the same key
   ;; for other roots), then the embedding (:r9-embedding-neighbour)
   :site {:file "futon2/src/futon2/aif/focus_receipt.clj" :var "classify-target"}
   ;; its return value crosses to cascade-decision-admitted as :class
   :reads [:relations :derived-via] :writes [:class]}
  {:box/id :r9-embedding-neighbour :row 9 :box/kind :component
   :site {:file "futon2/src/futon2/aif/focus_receipt.clj" :var "embedding-neighbour"}
   ;; its receipt reaches classify-target as :derived-via
   :reads [:source-pins :min-cosine] :writes [:derived-via]}
  {:box/id :r9-relation-test :row 9 :box/kind :test
   ;; builds its inputs (fixture writes of :relations, :source-pins,
   ;; :min-cosine); reads the classification it asserts
   :site {:file "futon2/test/futon2/aif/relation_derivation_test.clj"}
   :reads [:class :derived-via]}
  {:box/id :r9-judge-refusal-read :row 9 :box/kind :component
   ;; WM-MAP-REPLAY-I, defect G: the translator the fix put between the
   ;; judge's :kind and the classifier's :outcome. judge-refusal reads :kind;
   ;; judge-refusal-abstention (below) writes :outcome; explicit-failure-kind
   ;; reads it. Before 321d82c8 neither translator var existed and the
   ;; judge's :kind met no reader (the replay test pins that at cdc492ec)
   :site {:file "futon2/src/futon2/aif/full_loop_runner.clj" :var "judge-refusal"}
   :reads [:kind]}
  {:box/id :r9-judge-refusal-abstention :row 9 :box/kind :component
   :site {:file "futon2/src/futon2/aif/full_loop_runner.clj" :var "judge-refusal-abstention"}
   :writes [:outcome]}
  {:box/id :r9-failure-classifier :row 9 :box/kind :component
   ;; the runner's classifier of a failed attempt, unchanged by the fix
   :site {:file "futon2/src/futon2/aif/full_loop_runner.clj" :var "explicit-failure-kind"}
   :reads [:failure-kind :outcome]}
  {:box/id :r9-class-model :row 9 :box/kind :component
   ;; the class observation model reads :target-class (destructured) and
   ;; hands it on in the model map to observation_model/class-of-state,
   ;; where :class-unknown-no-scalar-g is raised (:216). That last hop is
   ;; not declared: observation_model reads target-class only by :keys
   ;; destructuring, which the prover's occurrence check does not see
   ;; (WM-MAP-REPLAY-D list ii)
   :site {:file "futon2/scripts/futon2/report/war_machine.clj" :var "class-observation-model"}
   :reads [:target-class]}

  ;; ---- row 6, Clause A: :measurement on the click record.
  {:box/id :r6-sourced-rates :row 6 :box/kind :component
   :site {:file "futon2/src/futon2/aif/observation_rates.clj" :var "sourced-rates"}
   :writes [:measurement]}
  {:box/id :r6-cascade-lane :row 6 :box/kind :component
   :site {:file "futon2/scripts/futon2/report/war_machine.clj" :var "cascade-lane"}
   :reads [:measurement]}
  {:box/id :r6-test :row 6 :box/kind :test
   :site {:file "futon2/test/futon2/aif/click_measurement_test.clj"}
   :reads [:measurement]}

  ;; ---- row 8, Clause T: pair overlap in the field.
  {:box/id :r8-overlap :row 8 :box/kind :component
   :site {:file "futon2/src/futon2/aif/target_field.clj" :var "with-pair-overlap"}
   :writes [:pair-overlap]}
  {:box/id :r8-test :row 8 :box/kind :test
   :site {:file "futon2/test/futon2/aif/target_field_overlap_test.clj"}
   :reads [:pair-overlap]}

  ;; ---- row 10, publish: one tick observes publication.
  {:box/id :r10-observe-publication :row 10 :box/kind :component
   ;; H-publish: the click's run record :repair/publication, :receipt-committed
   ;; for the chosen action's repair id; enact-fn copies the value (step 12)
   :site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "observe-publication-fn"}
   ;; it writes the observation as {:publication-observed obs}; enact-fn
   ;; reads it and records it on the enactment record
   :writes [:publication-observed]}
  {:box/id :r10-test :row 10 :box/kind :test
   :site {:file "futon2/test/futon2/aif/publication_observed_test.clj"}
   :reads [:publication-observed]}

  ;; ---- loop closure: the scheduled entry, the field's eligibility, the
  ;; flight entry, clocking the chosen target into a lane (futon3c)
  {:box/id :loop-entry :box/kind :component
   :site {:file "futon2/scripts/wm_scheduled_run.clj" :var "-main"}
   :writes [:trigger]}
  {:box/id :eligibility :row 1 :box/kind :component
   :site {:file "futon2/src/futon2/aif/target_field.clj" :var "with-eligibility"}
   :writes [:eligible]}
  {:box/id :flight-entry :box/kind :component
   :site {:file "futon2/src/futon2/aif/flight_driver.clj" :var "resolve-target"}
   :reads [:chosen-target :draw-seed] :writes [:target-source]}
  {:box/id :dispatch :box/kind :component
   ;; run-flight! dispatches the seat through the runner, naming the target
   ;; as the mission (positional from the flight entry)
   :site {:file "futon2/src/futon2/aif/full_loop_runner.clj" :var "dispatch!"}
   :writes [:mission-id]}
  {:box/id :clock-in :box/kind :component
   ;; the invoke receipt clocks the seat's session to the mission and
   ;; persists the transition as a futon1b edge with STRING prop keys, so the
   ;; lineage it writes has no keyword at the site (a standing finding); the
   ;; outer cascade reading it is the self-caused path I4 asks about
   :site {:file "futon3c/src/futon3c/agency/clock_lineage.clj" :var "persist-clock!"}
   :reads [:mission-id] :writes [:clock-lineage]}
  {:box/id :loop-test :box/kind :test
   :site {:file "futon2/test/futon2/aif/loop_closure_test.clj"}
   :reads [:target-source :draw-seed]}

  ;; ---- row 11, warrants: done (futon3c 4e66c56c; futon2 8eaa3e23); no field.
  {:box/id :r11-warrants :row 11 :box/kind :component}]
 ;; The exemplar trace: the path a flight of M-autoclock-in takes through the
 ;; boxes, first selection to the next. A step is a box id, connected to the
 ;; previous one by a field written then read, or {:box id :hop :positional
 ;; :via "..."} where the code passes the value as an argument (checked only
 ;; as declared; the test counts these).
 :traces
 [{:target "M-autoclock-in"
   :boxes [:loop-entry
           :r1-outer-cascade
           :flight-entry
           {:box :dispatch :hop :positional :via "run-flight! calls runner/dispatch! with the target as the mission"}
           :clock-in
           {:box :r2-served-by-reading :hop :positional :via "read-fn calls proposal on the seat's quotes"}
           :r2-verifier
           {:box :r6-cascade-lane :hop :positional :via "the click: a POST that runs the tick's cascade lane"}
           {:box :r9-selection-law :hop :positional :via "the lane's ranked actions reach selection"}
           :r0-enact-step
           :r7-flight-call
           {:box :wc-checker :hop :positional :via "wc-verdict-fn runs bb proof2a_check.clj <click record> <enactment record> --wc --edn"}
           :r7-increment
           :r7-fold
           :r1-outer-cascade]}]
 ;; The checker's report over :boxes with {:heuristic? true}, exactly (futon3c
 ;; 58f1a8cb's checker, which classifies thread-first writes: the two
 ;; :heuristic-limit entries of 3e96fdce are gone). Row 9 wired at futon2
 ;; f498f3f3 (:candidate on the selection law): its two entries are gone.
 ;; Row 6 wired at futon2 946405c5 (:measurement on the certificate): its
 ;; two entries are gone. :field-roles, :owner-text, the :wc-verdict read and
 ;; the lineage chain (dispatch -> clock-in -> :clock-lineage -> outer
 ;; cascade) added with ct-projection 296a08ca: 4 new :standing entries.
 ;; Row 4 wired at futon2 2a89efb9 (efe/order-use reads the receipt's
 ;; :order; rank-cascade-actions writes :order-use): its two entries gone,
 ;; one :standing added (the test's fixture receipts). Row 2 wired at futon2
 ;; 9c7cd7bd (the extractor a namespace, scripts/futon2/wm/extract_outcomes.clj)
 ;; and db1f79c7 (read-fn records the served-by reading and :text-sha256):
 ;; its entry is gone. Row 3 wired at futon2 821f6ace (agency-answer-fn
 ;; passes :library-root; pending answers awaited): its two entries gone.
 ;; :enacted-steps added as a field (futon2 27d6072d: a step id or a typed
 ;; absence, never nil): the selection law writes it, the enactment step will
 ;; read it to know which pattern to enact first; no new finding. Row 8
 ;; wired at futon2 b44998f6/058c995e (target-field/with-pair-overlap writes
 ;; :pair-overlap): its two entries gone, one :standing added (the test's
 ;; fixture entries carry :next-step). Step 7 wired at futon2 aba5d260
 ;; (flight-driver/resolve-target reads :chosen-target and :draw-seed, writes
 ;; :target-source): the flight-entry entry and the loop-closure test file
 ;; entry are gone; one :standing (the test supplies :chosen-target). Step 8
 ;; wired at futon2 781335f1 (selection reads :enactment-records from the
 ;; fold and writes :e-source; the legacy store dropped as E's source): the
 ;; r7-selection and row-7 test-file entries gone; two :standing (the row-7
 ;; test's enactment fixtures; row 9's test projects :e-source away). Step
 ;; 10 built at futon2 fcc31531: enact-fn is a real site for rows 0 and 5
 ;; (writes :attempts, :grain-gate, :grain; reads :candidate), its not-built
 ;; assertion removed; row 0 keeps one to-do (starting at the recorded
 ;; enacted step); occurrences in test files are :standing fixtures. Step
 ;; 11 built at futon2 d6df5909: wc-verdict-fn is a real site (reads the
 ;; attempts, writes :wc; the verdict reaches increment positionally, the
 ;; trace's hop to the checker is positional), its test box added; the
 ;; not-built count is 2 and the trace's one gap the outer cascade. Step 12
 ;; built at futon2 8f40f425 (and 047ae257, 726b4d0b): observe-publication-fn
 ;; is a real site and the declared writer of :publication-observed (it
 ;; returns {:publication-observed obs}; enact-fn reads it and records it),
 ;; so the value's path runs through an observation box; one box left
 ;; unbuilt, the outer cascade. WM-DRIVER-I at futon2 cf9684c4: run-flight!
 ;; passes the wired steps (enact-fn, wc-fn, the library root, the cascades);
 ;; no box's declaration moves, findings unchanged.
 ;; Step 14 (WM-COAPPLY-I) at futon2 63246b57: the co-application kernel,
 ;; box :r4-coapply at cascade_model_manifest/co-apply-kernel (positional
 ;; from the rollout); :r4-constructor declares its :descent and :units
 ;; writes, :r4-order-use reads them, the step-14 test box reads them; two
 ;; standing findings added (order-kernel-test's :dup case hand-writes a
 ;; receipt order), 19 -> 21 (2 to-do, 19 standing).
 ;; WM-CLICK-REFUSAL-I at futon2 c7367eaa: a cascade-decision refusal is the
 ;; tick's typed abstention. :r9-judge-refusal (judge-refusal-sorry) writes
 ;; the sorry cell's :judge-refusal, :r9-abstention-carrier
 ;; (persist-run-record!, into abstention-carrier) reads it, the test box
 ;; reads it; findings unchanged, 21 (2 to-do, 19 standing).
 ;; WM-RELATION-I at futon2 1e1546f6: an M- target's relation is derived
 ;; (stated Relations, then the pinned embedding). :r9-classify-target
 ;; (focus_receipt/classify-target) reads the facets file's :relations,
 ;; :r9-embedding-neighbour reads its embedding :source-pins and
 ;; :min-cosine, :r9-relation-test builds them as fixtures. Six standing
 ;; findings added (three exogenous reads, three test fixture writes; the
 ;; reads carry no :field-roles entry: :constraint would project them as
 ;; preferences in I4, which they are not),
 ;; 21 -> 27 (2 to-do, 25 standing).
 ;; WM-MAP-REPLAY-I (futon2 1e1546f6, no code change): the map carries
 ;; defects G and I. G: :r9-decision writes :kind (the judge's typed
 ;; refusal), :r9-judge-refusal-read (full_loop_runner judge-refusal) reads
 ;; it; before 321d82c8 the reader was explicit-failure-kind reading
 ;; :failure-kind/:outcome, and the replay test
 ;; (wm-flight-replay-test) pins that variant at cdc492ec, where the pair
 ;; reports read-never-written/written-never-read. I: :r9-classify-target
 ;; writes :class, :r9-decision reads it and writes :target-class,
 ;; :r9-class-model (war_machine class-observation-model) reads it; the hop

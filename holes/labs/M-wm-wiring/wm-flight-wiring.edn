;; M-wm-wiring — component map for the flight of a lifecycle mission
;; (first target M-autoclock-in). Author claude-10, 2026-09-25, DERIVE's first
;; artefact (WM-MAP-I). Checked by futon3c.diagramprover.wiring over futon2's
;; files at :futon2-sha, materialised from git into a temp root by
;; test/futon3c/diagramprover/wm_flight_wiring_test.clj (the registered run).
;;
;; REFERENT. The sites are the code that flies: flight/run! (flight.clj:246),
;; whose production caller is flight_driver.clj:123 under --run; each click is
;; a POST to /api/alpha/wm/click that runs the tick in
;; scripts/futon2/report/war_machine.clj. N0 checks each component site
;; against a registered load closure (test-registry-307b8969, the
;; mission-reading-c8-test run, which loads the flight and the tick). The
;; earlier holes/labs/M-diagramprover/wm-wiring.edn records how close the
;; paper map came to mapping the futon3c pilot peripheral instead of the
;; futon2 War Machine; this map names futon2 files only.
;;
;; FORM. One component box per inventory row (0-11 of M-wm-wiring), plus a
;; test box per row as its declared reader. A box declares the fields the
;; WIRED code will read and write, at var grain; where the code does not do so
;; yet, the checker's finding is the row's to-do, and :expected-findings in
;; the registered test lists them exactly. Wiring a row deletes its expected
;; findings in the same commit as the code. Keys are chosen to be distinctive
;; at their site: conformance is textual (it counts comments) and direction is
;; checked only under {:heuristic? true}.
;;
;; Components outside futon2 are siteless (exempt from conformance, still in
;; the graph): the W_c checker (futon3c holes/labs/M-futon-seams/exemplar/
;; proof2a_check.clj, warranted separately, test-registry-1757d974).
{:spec/id :wm-flight-wiring
 :repos {"futon2" "946405c5" "futon3c" "58f1a8cb"}
 ;; The owner's text is the one constraint (exogenous: nothing on the map
 ;; writes it); the spans that locate and pin it are observations of it.
 ;; Read by futon3c.diagramprover.ct-projection (296a08ca).
 :field-roles {:owner-text :constraint :want-span :observation :text-sha256 :observation}
 :boxes
 [;; ---- row 1, Clause T: target. The field exists; the outer cascade does not.
  {:box/id :r1-target-field :row 1 :box/kind :component
   :site {:file "futon2/src/futon2/aif/target_field.clj" :var "step"}
   :writes [:next-step]}
  {:box/id :r1-outer-cascade :row 1 :box/kind :component
   :status :not-built :intended-site {:file "futon2/src/futon2/aif/outer_cascade.clj" :var "select"}
   :reads [:trigger :next-step :eligible :pair-overlap :enactment-records :publication-observed
           :clock-lineage]
   :writes [:chosen-target :draw-seed]}
  {:box/id :r1-test :row 1 :box/kind :test
   :site {:file "futon2/test/futon2/aif/outer_cascade_test.clj"}
   :reads [:draw-seed]}

  ;; ---- row 2, Clause C: the read step. Components exist; the flight does not call them.
  {:box/id :r2-served-by-reading :row 2 :box/kind :component
   :site {:file "futon2/src/futon2/aif/served_by_reading.clj" :var "proposal"}
   :reads [:owner-text] :writes [:want-span :text-sha256]}
  {:box/id :r2-verifier :row 2 :box/kind :component
   :site {:file "futon2/scripts/wm/extract-outcomes.clj" :var "verify-proposed-link"}
   :reads [:want-span :text-sha256]}
  {:box/id :r2-flight-read :row 2 :box/kind :component
   :site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "read-fn"}
   :reads [:text-sha256]}
  {:box/id :r2-test :row 2 :box/kind :test
   :site {:file "futon2/test/futon2/aif/served_by_reading_test.clj"}
   :reads [:want-span :text-sha256]}

  ;; ---- row 3, Clause C: the ask step passes the library root.
  {:box/id :r3-flight-ask :row 3 :box/kind :component
   :site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "agency-answer-fn"}
   :writes [:library-root]}
  {:box/id :r3-prompt :row 3 :box/kind :component
   :site {:file "futon2/src/futon2/aif/want_interpretation.clj" :var "prompt"}
   :reads [:library-root]}
  {:box/id :r3-test :row 3 :box/kind :test
   :site {:file "futon2/test/futon2/aif/flight_ask_library_test.clj"}
   :reads [:library-root]}

  ;; ---- row 4, Clause D: the kernel reads :order when the precedence is a linear extension.
  {:box/id :r4-constructor :row 4 :box/kind :component
   :site {:file "futon2/src/futon2/aif/construction.clj" :var "containment-order"}
   :writes [:precedence-violations]}
  {:box/id :r4-kernel :row 4 :box/kind :component
   :site {:file "futon2/src/futon2/aif/efe.clj" :var "rank-cascade-actions"}
   :reads [:precedence-violations]}
  {:box/id :r4-test :row 4 :box/kind :test
   :site {:file "futon2/test/futon2/aif/order_kernel_test.clj"}
   :reads [:precedence-violations]}

  ;; ---- rows 0, 5, 7, 9, Clause C/E: the enactment record. No writer exists (row 0).
  {:box/id :r0-enact-step :row 0 :box/kind :component
   :status :not-built :intended-site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "enact-fn"}
   :reads [:candidate] :writes [:attempts :grain-gate]}
  {:box/id :r0-test :row 0 :box/kind :test
   :site {:file "futon2/test/futon2/aif/flight_enact_test.clj"}
   :reads [:attempts]}
  {:box/id :r5-grain-gate :row 5 :box/kind :component
   :site {:file "futon2/src/futon2/aif/grain_gate.clj" :var "grain-gate"}
   :reads [:keyed-by]}
  {:box/id :r5-flight-call :row 5 :box/kind :component
   :status :not-built :intended-site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "enact-fn"}
   :writes [:keyed-by]}
  {:box/id :r5-test :row 5 :box/kind :test
   :site {:file "futon2/test/futon2/aif/flight_grain_gate_test.clj"}
   :reads [:grain-gate]}
  {:box/id :wc-checker :box/kind :component
   ;; futon3c bb script, siteless here
   :reads [:attempts :grain-gate :candidate] :writes [:wc-verdict]}
  {:box/id :r7-increment :row 7 :box/kind :component
   :site {:file "futon2/src/futon2/aif/enactment_habit.clj" :var "increment"}
   ;; the count is decided by :wc-verdict (delta 1 only on an empty
   ;; verdict); :attempts refuses attempts outside the candidate and
   ;; :candidate is the P_c join; both are identity, not the count
   :reads [:attempts :candidate :wc-verdict] :writes [:delta]}
  {:box/id :r7-flight-call :row 7 :box/kind :component
   ;; the flight hands check-c's verdict to increment unchanged
   :status :not-built :intended-site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "enact-fn"}
   :reads [:wc-verdict]}
  {:box/id :r7-fold :row 7 :box/kind :component
   :site {:file "futon2/src/futon2/aif/enactment_habit.clj" :var "fold"}
   :reads [:delta] :writes [:enactment-records]}
  {:box/id :r7-selection :row 7 :box/kind :component
   :site {:file "futon2/src/futon2/aif/policy.clj" :var "select-action-cascades"}
   :reads [:enactment-records]}
  {:box/id :r7-test :row 7 :box/kind :test
   :site {:file "futon2/test/futon2/aif/selection_reads_fold_test.clj"}
   :reads [:enactment-records]}
  {:box/id :r9-selection-law :row 9 :box/kind :component
   :site {:file "futon2/src/futon2/aif/policy.clj" :var "select-action-cascades"}
   :writes [:per-policy-argmax :candidate]}
  {:box/id :r9-decision :row 9 :box/kind :component
   :site {:file "futon2/scripts/futon2/report/war_machine.clj" :var "cascade-decision-admitted"}
   :reads [:per-policy-argmax]}
  {:box/id :r9-test :row 9 :box/kind :test
   :site {:file "futon2/test/futon2/aif/selection_law_candidate_test.clj"}
   :reads [:candidate :per-policy-argmax]}

  ;; ---- row 6, Clause A: :measurement on the click record.
  {:box/id :r6-sourced-rates :row 6 :box/kind :component
   :site {:file "futon2/src/futon2/aif/observation_rates.clj" :var "sourced-rates"}
   :writes [:measurement]}
  {:box/id :r6-cascade-lane :row 6 :box/kind :component
   :site {:file "futon2/scripts/futon2/report/war_machine.clj" :var "cascade-lane"}
   :reads [:measurement]}
  {:box/id :r6-test :row 6 :box/kind :test
   :site {:file "futon2/test/futon2/aif/click_measurement_test.clj"}
   :reads [:measurement]}

  ;; ---- row 8, Clause T: pair overlap in the field.
  {:box/id :r8-overlap :row 8 :box/kind :component
   :site {:file "futon2/src/futon2/aif/target_field.clj" :var "target-field"}
   :writes [:pair-overlap]}
  {:box/id :r8-test :row 8 :box/kind :test
   :site {:file "futon2/test/futon2/aif/target_field_overlap_test.clj"}
   :reads [:pair-overlap]}

  ;; ---- row 10, publish: one tick observes publication.
  {:box/id :r10-observe-publication :row 10 :box/kind :component
   :status :not-built :intended-site {:file "futon2/src/futon2/aif/flight_runner.clj" :var "observe-publication-fn"}
   :writes [:publication-observed]}
  {:box/id :r10-test :row 10 :box/kind :test
   :site {:file "futon2/test/futon2/aif/publication_observed_test.clj"}
   :reads [:publication-observed]}

  ;; ---- loop closure: the scheduled entry, the field's eligibility, the
  ;; flight entry, clocking the chosen target into a lane (futon3c)
  {:box/id :loop-entry :box/kind :component
   :site {:file "futon2/scripts/wm_scheduled_run.clj" :var "-main"}
   :writes [:trigger]}
  {:box/id :eligibility :row 1 :box/kind :component
   :site {:file "futon2/src/futon2/aif/target_field.clj" :var "with-eligibility"}
   :writes [:eligible]}
  {:box/id :flight-entry :box/kind :component
   :site {:file "futon2/src/futon2/aif/flight_driver.clj" :var "run-flight!"}
   :reads [:chosen-target]}
  {:box/id :dispatch :box/kind :component
   ;; run-flight! dispatches the seat through the runner, naming the target
   ;; as the mission (positional from the flight entry)
   :site {:file "futon2/src/futon2/aif/full_loop_runner.clj" :var "dispatch!"}
   :writes [:mission-id]}
  {:box/id :clock-in :box/kind :component
   ;; the invoke receipt clocks the seat's session to the mission and
   ;; persists the transition as a futon1b edge with STRING prop keys, so the
   ;; lineage it writes has no keyword at the site (a standing finding); the
   ;; outer cascade reading it is the self-caused path I4 asks about
   :site {:file "futon3c/src/futon3c/agency/clock_lineage.clj" :var "persist-clock!"}
   :reads [:mission-id] :writes [:clock-lineage]}
  {:box/id :loop-test :box/kind :test
   :site {:file "futon2/test/futon2/aif/loop_closure_test.clj"}
   :reads [:chosen-target]}

  ;; ---- row 11, warrants: done (futon3c 4e66c56c; futon2 8eaa3e23); no field.
  {:box/id :r11-warrants :row 11 :box/kind :component}]
 ;; The exemplar trace: the path a flight of M-autoclock-in takes through the
 ;; boxes, first selection to the next. A step is a box id, connected to the
 ;; previous one by a field written then read, or {:box id :hop :positional
 ;; :via "..."} where the code passes the value as an argument (checked only
 ;; as declared; the test counts these).
 :traces
 [{:target "M-autoclock-in"
   :boxes [:loop-entry
           :r1-outer-cascade
           :flight-entry
           {:box :dispatch :hop :positional :via "run-flight! calls runner/dispatch! with the target as the mission"}
           :clock-in
           {:box :r2-served-by-reading :hop :positional :via "read-fn calls proposal on the seat's quotes"}
           :r2-verifier
           {:box :r6-cascade-lane :hop :positional :via "the click: a POST that runs the tick's cascade lane"}
           {:box :r9-selection-law :hop :positional :via "the lane's ranked actions reach selection"}
           :r0-enact-step
           :wc-checker
           :r7-flight-call
           {:box :r7-increment :hop :positional :via "increment takes the verdict as an argument"}
           :r7-fold
           :r1-outer-cascade]}]
 ;; The checker's report over :boxes with {:heuristic? true}, exactly (futon3c
 ;; 58f1a8cb's checker, which classifies thread-first writes: the two
 ;; :heuristic-limit entries of 3e96fdce are gone). Row 9 wired at futon2
 ;; f498f3f3 (:candidate on the selection law): its two entries are gone.
 ;; Row 6 wired at futon2 946405c5 (:measurement on the certificate): its
 ;; two entries are gone. :field-roles, :owner-text, the :wc-verdict read and
 ;; the lineage chain (dispatch -> clock-in -> :clock-lineage -> outer
 ;; cascade) added with ct-projection 296a08ca: 4 new :standing entries. :kind :to-do is the
 ;; wiring's to-do list (a row wired deletes its entries in the same commit);
 ;; :standing says why an entry stays after wiring. Not-built boxes have no
 ;; site and so no conformance finding; the test asserts their intended sites
 ;; absent instead. :error of a :site-unreadable finding is compared as
 ;; :error? true. :rows, :kind and :note are annotations the test strips.
 :expected-findings
 [{:finding :read-never-written,
   :field :owner-text,
   :readers [:r2-served-by-reading],
   :rows [2],
   :kind :standing,
   :note
   "the owner's text is exogenous by design: the one constraint, written by nothing on the map"}
  {:finding :declaration-without-occurrence,
   :box/id :flight-entry,
   :field :chosen-target,
   :role :reads,
   :site
   {:file "futon2/src/futon2/aif/flight_driver.clj",
    :var "run-flight!"},
   :rows [],
   :kind :to-do,
   :note
   "loop closure: the flight entry takes the outer cascade's chosen target instead of --target"}
  {:finding :declaration-without-occurrence,
   :box/id :clock-in,
   :field :clock-lineage,
   :role :writes,
   :site
   {:file "futon3c/src/futon3c/agency/clock_lineage.clj",
    :var "persist-clock!"},
   :rows [],
   :kind :standing,
   :note
   "persist-clock! writes the lineage edge with string prop keys into futon1b; no keyword names it at the site"}
  {:finding :declaration-without-occurrence,
   :box/id :r7-selection,
   :field :enactment-records,
   :role :reads,
   :site
   {:file "futon2/src/futon2/aif/policy.clj",
    :var "select-action-cascades"},
   :rows [7 9],
   :kind :to-do}
  {:finding :declaration-without-occurrence,
   :box/id :r3-flight-ask,
   :field :library-root,
   :role :writes,
   :site
   {:file "futon2/src/futon2/aif/flight_runner.clj",
    :var "agency-answer-fn"},
   :rows [3],
   :kind :to-do}
  {:finding :declaration-without-occurrence,
   :box/id :r2-served-by-reading,
   :field :owner-text,
   :role :reads,
   :site
   {:file "futon2/src/futon2/aif/served_by_reading.clj",
    :var "proposal"},
   :rows [2],
   :kind :standing,
   :note
   "the owner's text enters proposal as its TEXT argument (positional); no keyword names it at the site"}
  {:finding :declaration-without-occurrence,
   :box/id :r8-overlap,
   :field :pair-overlap,
   :role :writes,
   :site
   {:file "futon2/src/futon2/aif/target_field.clj",
    :var "target-field"},
   :rows [8],
   :kind :to-do}
  {:finding :declaration-without-occurrence,
   :box/id :r4-kernel,
   :field :precedence-violations,
   :role :reads,
   :site
   {:file "futon2/src/futon2/aif/efe.clj", :var "rank-cascade-actions"},
   :rows [4],
   :kind :to-do}
  {:finding :declaration-without-occurrence,
   :box/id :r2-flight-read,
   :field :text-sha256,
   :role :reads,
   :site
   {:file "futon2/src/futon2/aif/flight_runner.clj", :var "read-fn"},
   :rows [2],
   :kind :to-do}
  {:role :reads,
   :site
   {:file "futon2/src/futon2/aif/enactment_habit.clj",
    :var "increment"},
   :box/id :r7-increment,
   :field :wc-verdict,
   :heuristic true,
   :note
   "the verdict enters increment positionally; the one :wc-verdict keyword at the site writes the receipt's typed absence, so no read position exists",
   :rows [7],
   :usage {:reads 0, :writes 1, :unclassified 0},
   :kind :standing,
   :finding :declared-read-not-found}
  {:finding :occurrence-without-declaration,
   :field :next-step,
   :site
   {:file "futon2/src/futon2/aif/target_field.clj",
    :var "with-eligibility"},
   :declared-by [],
   :rows [1],
   :kind :standing,
   :note
   "with-eligibility's docstring names :next-step (textual scan counts docstrings); the function neither reads nor writes it"}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/target_field_overlap_test.clj"},
   :error? true,
   :rows [8],
   :kind :to-do}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/flight_ask_library_test.clj"},
   :error? true,
   :rows [3],
   :kind :to-do}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/order_kernel_test.clj"},
   :error? true,
   :rows [4],
   :kind :to-do}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/selection_reads_fold_test.clj"},
   :error? true,
   :rows [7],
   :kind :to-do}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/flight_grain_gate_test.clj"},
   :error? true,
   :rows [5],
   :kind :to-do}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/outer_cascade_test.clj"},
   :error? true,
   :rows [1],
   :kind :to-do}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/flight_enact_test.clj"},
   :error? true,
   :rows [0],
   :kind :to-do}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/publication_observed_test.clj"},
   :error? true,
   :rows [10],
   :kind :to-do}
  {:finding :site-unreadable,
   :site {:file "futon2/test/futon2/aif/loop_closure_test.clj"},
   :error? true,
   :rows [],
   :kind :to-do}]}

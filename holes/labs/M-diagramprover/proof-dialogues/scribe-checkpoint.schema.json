{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "futon3c.proof-dialogue-scribe-checkpoint/v1",
  "type": "object",
  "required": ["schema", "through_move_id", "conversation", "proof", "patterns", "open_obligations"],
  "properties": {
    "schema": {"const": "futon3c.proof-dialogue-scribe-checkpoint/v1"},

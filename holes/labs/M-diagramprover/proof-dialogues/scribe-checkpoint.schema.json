    "conversation": {"type": "object", "required": ["nodes", "edges"]},
    "proof": {"type": "object", "required": ["nodes", "edges"]},
    "patterns": {"type": "array"},
    "open_obligations": {"type": "array", "items": {"type": "string"}}
  }
}

  "title": "Tourniquet selection on pre-admission survival",
  "topology_basis": "printed_diagram",
  "content": "Table 9.1 contains only soldiers who survived to hospital admission. Figure 9.13 shows Injury Severity confounding Tourniquet Use, Pre-Admission Survival, and Post-Admission Survival. Conditioning on Injury Severity is necessary, but the hospital cohort also conditions on the mediator Pre-Admission Survival and therefore blocks the possible indirect benefit of tourniquets. The dashed direct arrow is hypothetical and unsupported by the table; its estimated effect is essentially zero.",
  "variables": [
    {"key": "injury_severity", "name": "Injury Severity", "content": "Injury severity category 3, 4, or 5.", "value_domain": "categorical", "domain_values": [3, 4, 5]},
    {"key": "tourniquet_use", "name": "Tourniquet Use", "content": "Whether a tourniquet was applied before hospital arrival.", "value_domain": "boolean"},
    {"key": "pre_admission_survival", "name": "Pre-Admission Survival", "content": "Whether the soldier survived long enough to reach the hospital.", "value_domain": "boolean"},
    {"key": "post_admission_survival", "name": "Post-Admission Survival", "content": "Whether the admitted patient survived after hospital admission.", "value_domain": "boolean"}
  ],

{
  "example_id": "firing-squad",
  "title": "Firing-squad intervention and counterfactual",
  "topology_basis": "printed_diagram",
  "content": "Pearl's Boolean firing-squad structural model. The court order causes the captain's signal; the signal causes both soldiers to shoot; either shot causes the prisoner's death.",
  "variables": [
    {
      "key": "court-order",
      "name": "Court Order (CO)",
      "content": "Whether the court issued the execution order.",
      "value_domain": "boolean"
    },
    {
      "key": "captain",
      "name": "Captain (C)",
      "content": "Whether the captain signaled the firing squad to fire.",
      "value_domain": "boolean",
      "structural_expression": {
        "kind": "variable",
        "variable": "court-order"
      }
    },
    {
      "key": "soldier-a",
      "name": "Soldier A (A)",
      "content": "Whether Soldier A fired.",
      "value_domain": "boolean",
      "structural_expression": {
        "kind": "variable",
        "variable": "captain"
      }
    },
    {
      "key": "soldier-b",
      "name": "Soldier B (B)",
      "content": "Whether Soldier B fired.",
      "value_domain": "boolean",
      "structural_expression": {
        "kind": "variable",
        "variable": "captain"
      }
    },
    {
      "key": "death",
      "name": "Death (D)",
      "content": "Whether the prisoner died.",
      "value_domain": "boolean",
      "structural_expression": {
        "kind": "or",
        "operands": [
          {
            "kind": "variable",
            "variable": "soldier-a"
          },
          {
            "kind": "variable",
            "variable": "soldier-b"
          }
        ]
      }
    }
  ],
  "arrows": [
    {
      "source": "court-order",
      "target": "captain",
      "because": "The captain signals only after receiving the court's order."
    },
    {
      "source": "captain",
      "target": "soldier-a",
      "because": "Soldier A is obedient and fires only on the captain's command."
    },
    {
      "source": "captain",
      "target": "soldier-b",
      "because": "Soldier B is obedient and fires only on the captain's command."
    },
    {
      "source": "soldier-a",
      "target": "death",
      "because": "Soldier A is an expert marksman, so his shot kills the prisoner."
    },

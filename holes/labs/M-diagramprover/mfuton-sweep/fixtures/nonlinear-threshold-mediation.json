      "value_domain": "rational",
      "affine_equation": {"kind": "affine", "intercept": 0, "coefficients": {"education": 2}, "disturbance": "U_SKILL"}
    },
    {
      "key": "salary",
      "name": "Salary",
      "content": "Salary is seven times Education plus three times Skill.",
      "value_domain": "rational",
      "affine_equation": {"kind": "affine", "intercept": 0, "coefficients": {"education": 7, "skill": 3}, "disturbance": "U_SALARY"}

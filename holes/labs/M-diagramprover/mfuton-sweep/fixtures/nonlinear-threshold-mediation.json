      "key": "outcome",
      "name": "Outcome",
      "content": "The applicant accepts exactly when Salary exceeds ten.",
      "value_domain": "boolean",
      "structural_expression": {"kind": "greater_than", "variable": "salary", "threshold": 10}
    }

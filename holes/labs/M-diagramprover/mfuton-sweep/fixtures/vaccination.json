{
  "example_id": "vaccination",
  "title": "Smallpox vaccination policy counterfactual",
  "topology_basis": "printed_diagram",
  "content": "Pearl's probabilistic vaccination model. Vaccination can cause a dangerous reaction while preventing smallpox; reaction and smallpox can each cause death.",
  "variables": [
    {
      "key": "vaccination",
      "name": "Vaccination",
      "content": "Whether a child is vaccinated. The factual population vaccination rate is 99 percent.",
      "value_domain": "boolean",
      "probability_table": {
        "rows": [
          {
            "when": {},
            "probability_true": {"numerator": 99, "denominator": 100}
          }
        ]
      }
    },
    {
      "key": "reaction",
      "name": "Reaction",
      "content": "Whether a child develops a reaction to the vaccine.",
      "value_domain": "boolean",
      "probability_table": {
        "rows": [
          {
            "when": {"vaccination": false},
            "probability_true": {"numerator": 0, "denominator": 1}
          },
          {
            "when": {"vaccination": true},
            "probability_true": {"numerator": 1, "denominator": 100}
          }
        ]
      }
    },
    {
      "key": "smallpox",
      "name": "Smallpox",
      "content": "Whether a child develops smallpox.",
      "value_domain": "boolean",
      "probability_table": {
        "rows": [
          {
            "when": {"vaccination": false},
            "probability_true": {"numerator": 1, "denominator": 50}
          },
          {
            "when": {"vaccination": true},
            "probability_true": {"numerator": 0, "denominator": 1}
          }
        ]
      }
    },
    {
      "key": "death",
      "name": "Death",
      "content": "Whether a child dies from a vaccine reaction or smallpox.",
      "value_domain": "boolean",
      "probability_table": {
        "rows": [
          {
            "when": {"reaction": false, "smallpox": false},
            "probability_true": {"numerator": 0, "denominator": 1}
          },
          {
            "when": {"reaction": false, "smallpox": true},
            "probability_true": {"numerator": 1, "denominator": 5}
          },
          {
            "when": {"reaction": true, "smallpox": false},
            "probability_true": {"numerator": 1, "denominator": 100}
          }
        ]
      }
    }

;; WIRING DIAGRAM — M-futon-seams instance 4, candidate a (registry-first).
;; The cascade is the ARGUMENT: which patterns, and how each narrows the space.
;; This is the CONSTRUCTION: what gets built, in what order, and what witnesses
;; it. Form follows holes/flights/first-flights-wiring.edn, with one change:
;; every interior node names the pattern that licenses it as a typed
;; :licensed-by id rather than in prose, which is E-flight-aif finding W1-b.
;;
;; Satiety is set from what actually happened, not from the plan:
;; exemplar/click-001-outcome.edn (d9825670), enacted at futon3c 8e5c431e.
;; A node whose token came back :partial is hungry and carries the evidence as
;; :owed. The provider-grain change that was actually built has no node on the
;; planned path, so it is drawn as a node OFF that path -- the deviation, not
;; folded into a planned node that would then look half-done.
;; Authored by claude-1, 2026-09-24. DRAFT pending claude-10's review.
{:mission "M-futon-seams"
 :artifact :wiring-diagram
 :instance 4
 :candidate :cand/a-registry-first
 :cascade {:path "holes/labs/M-futon-seams/proto/instance-4.edn"
           :sha256 "8a8f7528ded74de1309a7b55c57aa0cdfccfef180081e3c272f4add1aacfce1b"}
 :outcome {:path "holes/labs/M-futon-seams/exemplar/click-001-outcome.edn"
           :commit "d9825670" :enacted-at "futon3c 8e5c431e"}

 :nodes
 [{:id :have-port :role :scope
   :form "51 provider-literal agent ids in src/; three sites route by reading the provider out of the identifier"
   :satiety :full
   :via "boundary port: the state the mission measures at instance 4"}

  {:id :want-port :role :scope
   :form "code asks for a role; a role resolves to a seat; no identifier carries a routing decision"
   :satiety {:hungry-for :payoff}
   :owed "none of the three wants is met: caller-converted, redirect-test and prefix-routing-retired all came back :partial"
   :via "boundary port: the mission's IDENTIFY exit for this instance"}

  {:id :sites-listed :role :concept
   :form "every provider-naming site enumerated"
   :licensed-by :or3/count-every-card-back
   :produces :sites-enumerated
   :satiety {:hungry-for :evidence}
   :owed "2 of 3 routing branches converted; the third (library_loop_adapter.clj, the codex binary name) was not in the count. The 51 provider-literal ids were never enumerated: 16 src files still carry seat literals."
   :via "the count has to close before anything is changed, or what is left behind is invisible"}

  {:id :role-grain :role :concept
   :form "the grain is the ROLE: what one dispatch changes, persisting while seats come and go"
   :licensed-by :cascade-construction/choose-the-grain-where-state-lives
   :produces :roles-named
   :satiety {:hungry-for :construction}
   :owed "observed false. No role vocabulary exists. futon3c.agency.roles is about providers."
   :via "the choice the whole construction rests on, and the one the enactment did not make"}

  {:id :binding-record :role :concept
   :form "role-to-seat binding as an explicit record; a conflicting binding is rejected"
   :licensed-by :coordination/assignment-binding
   :produces :binding-recorded
   :satiety {:hungry-for :construction}
   :owed "observed false. The binding in use is the pre-existing :agent/type set at registration."
   :via "makes the binding a thing that can be read, contested and replayed"}

  {:id :one-resolver :role :concept
   :form "exactly one place resolves a role to a seat"
   :licensed-by :cycle-machine/single-producer
   :produces :one-producer
   :satiety {:hungry-for :evidence}
   :owed "one place now answers which PROVIDER an agent is (roles/provider); no place answers which seat plays a role"
   :via "three sites derived it independently; one producer with a contract test is the pattern's requirement"}

  {:id :caller-moved :role :concept
   :form "one call site asks for a role instead of naming a seat"
   :licensed-by :gauntlet/placenta-transfer
   :produces :caller-converted
   :satiety {:hungry-for :construction}
   :owed "two call sites in http.clj now call roles/ instead of parsing the id — but they ask for a provider, not a role"
   :via "the function the operator performs by hand, transferred once"}

  {:id :redirect-check :role :concept
   :form "rebinding a role to another seat changes which seat runs, with a falsifier"
   :licensed-by :translation/test-by-reproducing-behaviour
   :produces :redirect-test
   :satiety {:hungry-for :construction}
   :owed "roles_test passes 4 tests / 14 assertions, and 8 of 14 fail against the old prefix definitions, so it is a real falsifier — but it redeclares a PROVIDER for a fixed id. Rebinding a role cannot be tested because roles do not exist."
   :via "the mission's own acceptance method"}

  {:id :prefix-retired :role :concept
   :form "no code reads a provider out of an identifier"
   :licensed-by :realtime/mode-gate
   :produces :prefix-routing-retired
   :satiety {:hungry-for :evidence}
   :owed "grep for the starts-with? provider branches returns 0. The library-loop adapter still requires the literal codex binary and 'exec' — provider coupling in the command shape rather than in an id."
   :via "retirement once the test carries the behaviour"}

  ;; OFF THE PLANNED PATH. Real work, licensed by nothing in this cascade.
  {:id :provider-lookup :role :deviation
   :form "futon3c.agency.roles: one function answering which PROVIDER an agent is, from the registered :agent/type"
   :licensed-by :deviation/none
   :satiety :full
   :witness "8e5c431e; live check on :6768 returns wm-author→:codex, wm-reviewer→:codex, oxf-codex-3→:codex, codex-1→:codex, claude-10→:claude; reloaded by claude-11 from master"
   :via "what was actually built. It removes the string parsing, which the cascade also wanted, at the PROVIDER grain, which the cascade explicitly rejected. Drawn off the path because folding it into :role-grain would make a different construction look like a half-finished one."}]

 :hyperedges
 [{:kind :composes :ends [{:role :from :node :have-port} {:role :to :node :sites-listed}]
   :via "the state as measured enters the count"}
  {:kind :composes :ends [{:role :from :node :have-port} {:role :to :node :role-grain}]
   :via "and the same state raises the grain question, independently of the count"}
  {:kind :composes :ends [{:role :from :node :role-grain} {:role :to :node :binding-record}]
   :via "the grain decides what a binding record is a record of"}
  {:kind :composes :ends [{:role :from :node :binding-record} {:role :to :node :one-resolver}]
   :via "a record can be asked who writes it"}
  {:kind :composes :ends [{:role :from :node :sites-listed} {:role :to :node :caller-moved}]
   :via "you cannot convert what you have not counted"}
  {:kind :composes :ends [{:role :from :node :one-resolver} {:role :to :node :caller-moved}]
   :via "and there must be something to convert to"}
  {:kind :composes :ends [{:role :from :node :caller-moved} {:role :to :node :redirect-check}]
   :via "a converted caller is what the check acts on"}
  {:kind :composes :ends [{:role :from :node :redirect-check} {:role :to :node :prefix-retired}]
   :via "retire once the behaviour is carried"}
  {:kind :composes :ends [{:role :from :node :prefix-retired} {:role :to :node :want-port}]
   :via "with no identifier carrying a decision the want port closes"}
  {:kind :deviates :ends [{:role :from :node :have-port} {:role :to :node :provider-lookup}]
   :via "the implementer worked from the mission's defect description rather than from the chosen cascade"}
  {:kind :partly-discharges :ends [{:role :from :node :provider-lookup} {:role :to :node :prefix-retired}]
   :via "it does remove the string parsing, which is one of the three wants, partly"}
  {:kind :partly-discharges :ends [{:role :from :node :provider-lookup} {:role :to :node :caller-moved}]
   :via "and it does move two call sites off id-parsing, at the wrong grain"}]

 :finding
 {:kind :enactment-not-bound-to-candidate
  :statement "The planned path and the built thing meet only at two :partly-discharges edges. Nothing in PROOF-2a requires them to meet at all: clause 4's Q-link joins action to outcome to next belief, where 'action' is the selected candidate, and no clause checks that what was done IS that candidate. This diagram is that gap drawn."}}

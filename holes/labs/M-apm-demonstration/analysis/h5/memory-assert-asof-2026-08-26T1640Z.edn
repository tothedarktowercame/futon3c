ntry "e-07f83183-c3ec-4f69-84fe-0cc44932218d", :subjects ["a95J04" "math-formalization/additive-principal-parts-from-order-germs"], :distills ["004066cafc48d0c5623c5a04688a13a7f870a970ad9f209289458f771f2be9cb" "5a9dcabdde711eb07812f28a0bfd014f4d6b5f5736ff3e0d6673633aa9c31293"], :session "zai-d3fe0f23-d3d4-47c5-9a89-2a2faddfd304", :patterns ["math-formalization/additive-principal-parts-from-order-germs"]}, :kind :feedback, :name "additive-principal-parts-from-order-germs", :hook "Divisor API gives no additive principal parts: build them from order germs and germ Taylor expansion", :volatile? false, :state :current, :domain :zaif-work, :attachment-status :proposed}, :prop/state :current, :prop/kind :feedback, :prop/domain :zaif-work, :hx/type :memory/assert, :prop/attachment-status :proposed} {:prop/witness-status :independently-witnessed, :hx/endpoints ["e-082d154e-a52a-4697-92a7-61880d47f07c" "a97J06" "math-formalization/cast-normalization" "apm-role-0ab6967207acf7e015b61c3da0fe892f063968c853d82e1e3ee637e41bfa7c6a"], :prop/volatile? false, :prop/hook "A real integral is being evaluated by pushing it through a complex transform; `push_cast`/`norm_cast` have already normalized every coercion onto an atom, and the real-part projection STILL will not simplify. The cause is not the casts. The library's `integral_re` commutation lemma is stated over a GENERIC RCLike field, so what you get back is headed by `RCLike.re`, not `Complex.re`, and no `Complex.*_re` projection lemma fires on it, while a bare `simp` can instead expand through `RCLike.normSq_to_complex` into `normSq` junk. Convert the head first with the rfl-simp lemmas `RCLike.re_to_complex` / `im_to_complex` / `I_to_complex` (namespace `RCLike`, `Mathlib/Analysis/Complex/Basic.lean`), or restate the goal with `show Complex.re _ = _`. Better: enter the complex world at the START, by rewriting the real integrand BACKWARDS through `← RCLike.re_to_complex` and only then applying `integral_re` — which is exactly how Mathlib proves its own real exponential integrals over `Ioi`.", :hx/id "hx-mem-082d154e-a52a-4697-92a7-61880d47f07c", :hx/ends [{:entity-id "e-082d154e-a52a-4697-92a7-61880d47f07c"} {:entity-id "a97J06"} {:entity-id "math-formalization/cast-normalization"} {:entity-id "apm-role-0ab6967207acf7e015b61c3da0fe892f063968c853d82e1e3ee637e41bfa7c6a"}], :prop/roles {:entry "e-082d154e-a52a-4697-92a7-61880d47f07c", :subjects ["a97J06" "math-formalization/cast-normalization"], :distills [], :session "apm-role-0ab6967207acf7e015b61c3da0fe892f063968c853d82e1e3ee637e41bfa7c6a", :patterns ["math-formalization/cast-normalization"]}, :prop/name "real-part-projection-blocked-by-generic-rclike-head", :hx/props {:hook "A real integral is being evaluated by pushing it through a complex transform; `push_cast`/`norm_cast` have already normalized every coercion onto an atom, and the real-part projection STILL will not simplify. The cause is not the casts. The library's `integral_re` commutation lemma is stated over a GENERIC RCLike field, so what you get back is headed by `RCLike.re`, not `Complex.re`, and no `Complex.*_re` projection lemma fires on it, while a bare `simp` can instead expand through `RCLike.normSq_to_complex` into `normSq` junk. Convert the head first with the rfl-simp lemmas `RCLike.re_to_complex` / `im_to_complex` / `I_to_complex` (namespace `RCLike`, `Mathlib/Analysis/Complex/Basic.lean`), or restate the goal with `show Complex.re _ = _`. Better: enter the complex world at the START, by rewriting the real integrand BACKWARDS through `← RCLike.re_to_complex` and only then applying `integral_re` — which is exactly how Mathlib proves its own real exponential integrals over `Ioi`.", :volatile? false, :name "real-part-projection-blocked-by-generic-rclike-head", :roles {:entry "e-082d154e-a52a-4697-92a7-61880d47f07c", :subjects ["a97J06" "math-formalization/cast-normalization"], :distills [], :session "apm-role-0ab6967207acf7e015b61c3da0fe892f063968c853d82e1e3ee637e41bfa7c6a"
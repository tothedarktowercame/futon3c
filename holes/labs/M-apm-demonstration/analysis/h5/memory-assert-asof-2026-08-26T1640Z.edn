n :zaif-work, :state :current}, :prop/state :current, :prop/kind :feedback, :prop/domain :zaif-work, :hx/type :memory/assert} {:hx/endpoints ["e-cd762fa0-77d5-499a-9703-7093f1fa49c2" "a97J06" "apm-role-6c5c056af7d2b0ccb4e8011c0968decced3d69d036cd53de9548cfd6be619853" "math-formalization-CA/measure-integration-api"], :prop/volatile? false, :prop/hook "Reaching the library's one-sided complex-exponential integrals — `integral_exp_mul_complex_Ioi` / `_Iic` and their `integrableOn_` partners — requires the integrand to be LITERALLY `Complex.exp (a * ↑x)` with `a : ℂ` a constant, but what you have is a product: an oscillatory phase `Complex.exp (↑(c * x * w) * Complex.I)` times a cast real decay `((Real.exp (d * x) : ℝ) : ℂ)`. Applying `congr 1` to that product cannot work — it would have to match the two factors separately, which they never do — and the error it reports is a cast-of-a-compound versus compound-of-casts mismatch, so it reads as a coercion problem and you re-run `push_cast` instead of changing the shape. Fuse the two exponentials FIRST: `rw [Complex.ofReal_exp, ← Complex.exp_add]`, then state the equality of the two exponential ARGUMENTS as a standalone `have` closed by `congr 1; push_cast; ring`, and rewrite the goal with that `have`. Only after the fusion is `congr 1` acting on `Complex.exp _ = Complex.exp _`, where it is exactly the right tactic.", :hx/id "hx-mem-cd762fa0-77d5-499a-9703-7093f1fa49c2", :hx/ends [{:entity-id "e-cd762fa0-77d5-499a-9703-7093f1fa49c2"} {:entity-id "a97J06"} {:entity-id "apm-role-6c5c056af7d2b0ccb4e8011c0968decced3d69d036cd53de9548cfd6be619853"} {:entity-id "math-formalization-CA/measure-integration-api"}], :prop/roles {:entry "e-cd762fa0-77d5-499a-9703-7093f1fa49c2", :subjects ["a97J06" "math-formalization-CA/measure-integration-api"], :distills [], :session "apm-role-6c5c056af7d2b0ccb4e8011c0968decced3d69d036cd53de9548cfd6be619853", :patterns ["math-formalization-CA/measure-integration-api"]}, :prop/name "fuse-phase-and-decay-into-one-complex-exponential-before-congr", :hx/props {:hook "Reaching the library's one-sided complex-exponential integrals — `integral_exp_mul_complex_Ioi` / `_Iic` and their `integrableOn_` partners — requires the integrand to be LITERALLY `Complex.exp (a * ↑x)` with `a : ℂ` a constant, but what you have is a product: an oscillatory phase `Complex.exp (↑(c * x * w) * Complex.I)` times a cast real decay `((Real.exp (d * x) : ℝ) : ℂ)`. Applying `congr 1` to that product cannot work — it would have to match the two factors separately, which they never do — and the error it reports is a cast-of-a-compound versus compound-of-casts mismatch, so it reads as a coercion problem and you re-run `push_cast` instead of changing the shape. Fuse the two exponentials FIRST: `rw [Complex.ofReal_exp, ← Complex.exp_add]`, then state the equality of the two exponential ARGUMENTS as a standalone `have` closed by `congr 1; push_cast; ring`, and rewrite the goal with that `have`. Only after the fusion is `congr 1` acting on `Complex.exp _ = Complex.exp _`, where it is exactly the right tactic.", :volatile? false, :name "fuse-phase-and-decay-into-one-complex-exponential-before-congr", :roles {:entry "e-cd762fa0-77d5-499a-9703-7093f1fa49c2", :subjects ["a97J06" "math-formalization-CA/measure-integration-api"], :distills [], :session "apm-role-6c5c056af7d2b0ccb4e8011c0968decced3d69d036cd53de9548cfd6be619853", :patterns ["math-formalization-CA/measure-integration-api"]}, :state :current, :review {:evidence-id "e-apm-promotion-review-30a97009cd40deb7377bbe3a531e2d75", :reviewer "f41-promotion-proctor", :session-id "apm-role-b49398131462bb3a3f348497daea030a0f1033c3da1fe0fd4eb6054dd9f9f9e6", :verdict :reassign, :pattern-ids ["math-formalization-CA/measure-integration-api"], :reviewed-at "2026-08-26T10:01:08.065597671Z"}, :attachment-status :reviewed, :kind :reference, :review-history [{:evidence-id "e-apm-promotion-review-30a97009cd40deb7377bbe3a531e2d75", :reviewer "f41-promotion-proctor"
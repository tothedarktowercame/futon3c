;; M-象-2000 — 象2000 语族的级联，第 2 版（v2）。
;; v1：kimi-3，2026-09-26（cascade-象2000.edn，保留不动以便对照）。
;; v2：claude-17，2026-09-27，据 ARGUE-0 / ARGUE-1 与 futon3 827b1f9 的新模式修订。
;; 格式同 v1（M-futon-seams/proto/instance-5.edn）。未改动的模式块从 v1 逐字搬来，
;; 只刷新了 sha256；改动的块 :author 记为 claude-17。
;;
;; v2 相对 v1 的结构改动（每条都对应 ARGUE 的一处缺漏）：
;;  - 承诺：诺必践 另产出 :承诺终局分记（唤醒≠兑现，codex 点 2），欠与被欠 需要它。
;;  - 授权：名分有据 只产出 :授权来源；:行权有据 改由 释义非授 产出——解读与效力
;;    分开之后，「行权有据」才成立（codex 点 3）。
;;  - 时间与身份：新令牌 :双时（双时并记）与 :行为定名（行有定名）；收回亦是行 需要
;;    :行为定名（撤回要指向确定的一次行为），视图出于史 需要 :双时（codex 点 4）。
;;  - 历史：视图出于史 需要 :状态转换原子 与 :交接幂等（agency/state-atomicity、
;;    social/idempotent-handoff，codex 点 5——库中本有，v1 没有检索到）。
;;  - 制度：制度有时 需要 :三时分记（提交非生效）、:规则带失败方式（裁亦有失）、
;;    :三分回溯（覆水难收）；:清结证明 与 :成效可验 改由 措施随案 产出，陈述收窄
;;    为「已解决、措施可撤」（codex 点 1、6）。
;;  - 匹配：同构方为同 产出 :证实可分（codex 点 7）。它不在 :want 的路径上，是
;;    一个悬空产出——模式库的增长不属于「忠实的系统」，如实记为发现。
;;  - 过程：新增 :want 令牌 :建造可自验，由 每段自验 产出，需要 限定随论 与 引非读
;;    （ARGUE-1 U1、U4、U5）。这是 v2 最大的一处主张：设计必须对它自己的建造也成立。
;;    **需 Joe 验证：是否接受把 :建造可自验 加进 :want。**
;;  - 新洞 :反事实世界模型：覆水难收 把「若 P 在 T0 则不会出事」推迟到有世界模型之时。
{:schema :m-elephant-2000/cascade-v1
 :mission "M-象-2000"
 :instance 2
 :date "2026-09-27"
 :offset-unit :unicode-codepoints-zero-based-end-exclusive
 :supersedes {:path "futon3c/holes/labs/M-象-2000/cascade-象2000.edn" :instance 1}

 :tokens
 {;; —— 基础层：类型与引用 ——
  :类型化退回
  {:statement "无法翻译或无法行动的输入被带类型退回给能行动的一方并按成因计数，而不是被猜测执行。"}
  :行为类型
  {:statement "每一条消息或行为记录都携带言语行为类型与来源（操作者/代理/调度层），类型可由记录直接读出，而不必从散文里猜。"}
  :引用
  {:statement "承诺、答复与更正都带 ref 指向一条可按 as-of 时刻取回的记录，不复述内容。"}
  :投递回执
  {:statement "每次投递产生一条只证明送达的回执，或一条显式的失败记录；回执不声称工作完成。"}
  :显式退出承诺
  {:statement "无法兑现的承诺以一条显式退出记录终止并说明原因，而不是静默超时或任其漂移。"}
  :闸门响亮
  {:statement "检查由系统自行触发，按变化而非按状态报告，并把每个变化路由到能行动的人——常红的灯与没人启动的清扫同样不报告失败。"}
  :行为定名
  {:statement "【v2】每个行为在写入时铸出一个不透明 id，终身不变；类型与端点相同的两次行为是两个行为；ref 一律指这个 id，去重另用幂等键。"}
  :双时
  {:statement "【v2】每条行为记录带有效时间（事在世界里发生之时）与系统时间（记录得知之时）；每次连接与 as-of 查询声明读哪一轴。"}

  ;; —— 承诺与验收 ——
  :承诺落记
  {:statement "每个说出的承诺落成一条带受益方、内容、期限与兑现判据的记录，到期由系统按判据检查而非询问承诺方。"}
  :承诺终局分记
  {:statement "【v2】承诺的五种终局各记一条行为、互不代替：所等依赖终止、唤醒送达、兑现（判据成立）、释放、逾期；唤醒不是兑现。"}
  :送达与办成分记
  {:statement "投递回执与完成断言是两条独立记录；验收读工作留下的痕迹，痕迹为空时状态为「已送达，未执行」。"}
  :撤销类型
  {:statement "撤销是一等行为，带 ref 指向所撤之物，表现为该物有效时间的终止而非删除。"}
  :存续可查
  {:statement "「截至时刻 T 仍有效」是历史上的一个查询：arises 于 T 之前且 T 之前无撤销的承诺被返回。"}

  ;; —— 授权与协议 ——
  :授权来源
  {:statement "【v2 改】每个行为记录执行者、署名者与授权来源（ref 指回一次授予）；对每个行为按授予查范围、时间与委托链——署名者与执行者相同时也查。"}
  :解读效力分记
  {:statement "【v2】原事件、对它的解读（带版本、可驳回）、经授权而生的效力是三条记录；解读本身不创造、终止或转移任何承诺，改标时依赖旧版本的效力被列出待复核。"}
  :协议记录
  {:statement "要约与接受合成一条协议记录，含内容、双方、时刻与授权范围；分不清谁先提出时只记双方与内容。"}

  ;; —— 历史层 ——
  :状态转换原子
  {:statement "【v2】状态转换要么完整完成并持久化，要么退回原态并给出显式错误；不留半新半旧的状态。"}
  :交接幂等
  {:statement "【v2】异步交接重发两次、收到两次都只产生一个效果；以稳定的幂等键对账而不是重做。"}
  :历史完备
  {:statement "系统自身的每个行为（载入代码、入队、停泊、释放）在发生时入史；任何缓存或队列都可由历史重建并定期比对。"}
  :约束即关系
  {:statement "约束写成对行为历史的关系（谁、何时、哪种行为、指向什么），由匹配器在每个新行为到来时对历史求值，违反即生成记录。"}
  :假设明言
  {:statement "实现报告末尾列出会改变外部可见行为的假设，每条一行「未说明 X，取 Y」；操作者对一条的否定记为一次撤销并迫使实现覆盖该可能。"}
  :所弃成文
  {:statement "【v2】翻译与改写声明它舍弃了什么，与它保留了什么并列，使评审有一条可以核对的主张。"}
  :级联可判错
  {:statement "操作者回合到模式级联的翻译按六款契约逐款可被反驳：单位、所保、所弃、源绑定、等价判据、译不出的带类型退回。"}
  :三分回溯
  {:statement "【v2】重建（某时刻的记录）、重演（明言假设下的干预推演）、补救（对已记录效果的更正行为）是三种操作，各有结果与失败条件，不以一种的成功冒充另一种。"}
  :补救清单
  {:statement "【v2】事故期间已离开记录、进入世界的效果（已发出的通知、已重载的代码、已排队的作业）逐条列出，每条配一个更正行为或「无法补救」的说明。"}

  ;; —— 规格与制度 ——
  :三层规格成文
  {:statement "每条规则写明内部（装上了什么）、收发（拒绝或放行什么）、成效（要让世界变成什么样）三层规格，以及连接收发与成效的那条世界假设。"}
  :规则带失败方式
  {:statement "【v2】每条被采纳的规则——包括操作者的裁定——带一句 HOWEVER：它最可能的失败方式与观察到它时的信号；写不出时记「失败方式未知」并设复查点。"}
  :三时分记
  {:statement "【v2】规则的采纳（授权行为）、提交（sha）、生效（运行时证据）是三个时刻；「当时生效」只以第三个为准，缺它时答「已提交，未见生效」。"}
  :制度版本生效区间
  {:statement "【v2 改】每条协议、闸门与常规带版本与生效区间，区间以生效时刻（非提交时刻）为准；一个行为按它发生时有效的制度评判。"}
  :清结证明
  {:statement "【v2 改】事故清结证两件事：事故已解决；它名下每条措施（按立措施时所记的事故 ref，不按时间推断）或随清结撤下，或经一次独立采纳转为常设。附补救清单。不证「若 P 在 T0 则不会发生」。"}

  ;; —— :want 层的令牌 ——
  :回答声明总体
  {:statement "回答声明所依据的总体与取数时刻，并指出该总体与问题所指是否同一；不同一先说不同一，再给数字。"}
  :回答真实切题
  {:statement "回答既为真又答在问处；两关任缺其一，按无法回答退回，而不是以另一关的成绩冒充通过。"}
  :承诺可追讨
  {:statement "任意时刻 T 可列出每个代理的应付（承诺、停泊、所装规则，各带受益方与期限）与应收（等待中的回铃）；逾期未兑现的承诺可见、可归责、可撤销。"}
  :行权有据
  {:statement "任何行为都可沿授权树追溯到一次记录在案的授予；没有授予的行为被退回，且以他人名义发出的话不会让那人承担他未授予的义务。"}
  :成效可验
  {:statement "【v2 改】规则的成效在清结时被检验：成效落空时可定位于内部、收发、成效三层中哪一层失效；关于规则的主张限于「这条可执行规则能认出这段已记录的序列」，反事实待世界模型。"}
  :建造可自验
  {:statement "【v2】本设计对它自己的建造同样成立：每一阶段以重跑验收案检查成效；阶段交接带着所依主张的未解除限定；对代码的引用分等（点名/读过/测过），只点名者不计为满足。"}

  ;; —— 过程层的中间令牌 ——
  :限定随附
  {:statement "【v2】设计主张记为行为，限定与撤回以 ref 挂在主张上；阶段交接可查「本工件所依主张中未解除的限定」。"}
  :引用分等
  {:statement "【v2】对代码的引用分等：named（指针可解析）、read（写出所引代码做什么）、witnessed（测试或运行痕迹）；部分满足至少 read。"}

  ;; —— 模式库一侧（不在 :want 的路径上）——
  :证实可分
  {:statement "【v2】两条提案是否同一，逐项比对 IF/HOWEVER/THEN/BECAUSE 与范围；证实逐条记录作者与依赖，提案者自证与同一目录的回声不计为独立证实。"}

  ;; —— 洞（没有任何模式产出，见 :holes）——
  :正确性条件生成
  {:statement "从行为类型流机械地生成正确性条件：每个承诺生成一条兑现检查，每个回答生成一条真实且中的检查，每个命令生成一条授权检查（R3，elephant.tex l.172–178、1880–1886）。"}
  :答后知
  {:statement "回答使问者随后知道所问之值——elephant.tex l.838–893 的 knows-what 判据，「切题」的形式化（R5）。"}
  :输入侧学会记录
  {:statement "输入侧的「听到」与「学会」分记（R8 输入侧，elephant.tex l.2172–2180）：收到一条消息不等于理解它，理解本身是一条记录。"}
  :反事实世界模型
  {:statement "【v2】一个足以回答「若 P 在 T0 已生效，事故会不会发生」的世界模型：代理会如何回应 P、P 会拦下什么、被拦下的会转向何处。"}}

 :initial #{}
 :want #{:回答真实切题 :承诺可追讨 :行权有据 :成效可验 :建造可自验}

 :holes
 [{:status :open
   :token :正确性条件生成
   :wanted "麦卡锡的 R3 是「由程序文本生成」正确性条件（l.1880–1886：generated from the program text）。语族各模式各陈述一条条件（答真、践诺、行权有据），但没有模式说这些检查如何被生成出来——今天每条检查都要有人想起来去写。"
   :nearest "象/欠与被欠（能列出承诺，但不生成检查）与 象/三层规格（能说出成效层，但不生成对它的检查）"
   :nearest-sha256 "7db1b6fd9cb63452da63012403c34f0a5c88ead67230bf98cddeddf66da0cbb3"
   :consequence ":want 的令牌都依赖各自模式被遵守，而遵守本身没有机制保证；生成器缺位是语族从「主张」到「系统」之间最大的缝。v2 的 每段自验 在建造一侧给出了一个手工的替身（重跑验收案），在运行一侧没有。"}
  {:status :open
   :token :答后知
   :wanted "R5 的 knows-what 判据（l.882 一带）：responsive 的判据是问者随后知道所问之值。象/答必真且中的 只到「真」与「答在问处」，没有陈述问者侧的检验。"
   :nearest "象/答必真且中的"
   :nearest-sha256 "2dc7ab95fd1c304c2fd921f50463e832bca80b764d31ad7a77181f43f3a2f0d2"
   :consequence ":回答真实切题 仍可产出（答方记录可判），但「切题」缺了麦卡锡自己的形式化判据；补上它可能需要一次提问方的确认行为。"}
  {:status :open
   :token :输入侧学会记录
   :wanted "R8 的输入侧：delivered vs done 已有（两种规格），received vs understood 没有对应的模式——象的标注被 DERIVE-1 称为「learning that」的记录，但语族没有模式陈述它。"
   :nearest "象/两种规格（只写输出侧）"
   :nearest-sha256 "f673cdd04357ce550a140ade44637593668e1ec8d8409c6ccd860f9dc9ff73a6"
   :consequence "「收到级联者做了收到原回合者所做之事」（翻译契约的等价判据）预设了理解可判，而理解本身无记录；输入侧的缝使翻译契约的检验建立在一个未入史的事件上。"}
  {:status :open
   :token :反事实世界模型
   :wanted "【v2】v1 的 :清结证明 要证「若 P 在 T0 已生效，事故不会发生」。这是反事实，重建历史不提供它（象/覆水难收）。v2 把清结证明收窄为「已解决、措施可撤」，把反事实留在这里。"
   :nearest "象/覆水难收（区分了重演与重建，但只要求重演「明言假设」，不提供模型）"
   :nearest-sha256 "64d137574e3f90ca7a423a41fe4c0d7824859d409de7b6a95ec2a4c9fef4b8f6"
   :consequence ":成效可验 只到「可执行规则能认出已记录的序列」；「这条规则当时能否防止」在有世界模型之前不可验。MAP 的前瞻推断（标签流上的 MCMC）是这个模型最便宜的候选。"}]

 :patterns
 {;; —— 基础层 ——
  :translation/route-the-untranslatable

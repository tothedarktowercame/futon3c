    {:phase :uniform-removal
     :result "damped integral tends to the same `L` as `a → 0+`"
     :engine "uniform Dirichlet tail plus fixed-interval dominated convergence"}
    {:phase :identification
     :result "`L = π/2`, symmetric limit `π`"

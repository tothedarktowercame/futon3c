[{:name "derive-integrable-from-nonzero-bochner-integral"
  :lane :solve-lane
  :level :lemma-location
  :status :draft
  :body
  {:problem-class
   "A scalar kernel theorem assumes `∫ x, g x ∂volume = 1` but does not separately assume `Integrable g volume`."
   :proof-shape
   ["Assume `¬ Integrable g volume`."
    "Use `integral_undef` to obtain `∫ x, g x ∂volume = 0`."

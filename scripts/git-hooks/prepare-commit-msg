#!/bin/sh
# Sign each commit with the committing agent session, so a turn's own
# commits can be told from other seats' in a shared checkout (M-象-2000:
# rewinding a turn undoes only its own commits). Agents do nothing: the
# session id is already in their environment. A commit with no session id
# (Joe at a terminal) is left unsigned. This hook never blocks a commit.
#   $1 = message file, $2 = source (message|template|merge|squash|commit)
msg="$1"
sid="${CLAUDE_CODE_SESSION_ID:-${FUTON_AGENT_SESSION_ID:-}}"
[ -n "$sid" ] || exit 0
git interpret-trailers --in-place --if-exists addIfDifferent \
  --trailer "Agent-Session: $sid" "$msg" 2>/dev/null || true
exit 0

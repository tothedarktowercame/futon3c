[Unit]
Description=FUTON Matrix/象 chat authorization proxy
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/joe/code/futon3c
ExecStart=/usr/bin/python3 /home/joe/code/futon3c/scripts/xiang_chat_server.py
Environment=MATRIX_HOMESERVER_URL=https://matrix.paragogy.net
Environment=MATRIX_ROOM_ID=!_qvu9Pec8-hw1-nsN18SA8uIChKlJPmS4f4ji3zajRw
Environment=FUTON3C_BASE=http://127.0.0.1:7070
Environment=XIANG_CHAT_LISTEN=127.0.0.1
Environment=XIANG_CHAT_PORT=8131
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target

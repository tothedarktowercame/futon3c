{:inventory/version 1
 :inventory/scope :m-repl-circus
 :sources
 [{:source/id :participant-evidence
   :store "http://localhost:7073/api/alpha/evidence"
   :schema/version :evidence-landscape/current
   :pin/method :evidence-id
   :retention :durable
   :rebuild/role #{:input :non-recomputable}
   :check "curl -sS --max-time 5 'http://localhost:7073/api/alpha/evidence?limit=1'"}

  {:source/id :circus-turn-projection
   :store "~/.emacs-graph/session-turn-analysis/turn-*.json"
   :schema/version 1
   :pin/method :source-evidence-id
   :retention :unknown
   :rebuild/role #{:derived}
   :check "find ~/.emacs-graph/session-turn-analysis -maxdepth 1 -name 'turn-*.json' -printf '.' | head -c 5000 | wc -c"}

  {:source/id :pattern-definitions
   :store "~/code/futon3/library/*.flexiarg"
   :schema/version :flexiarg/current
   :pin/method :content-sha256
   :retention :git
   :rebuild/role #{:input}
   :check "find ~/code/futon3/library -maxdepth 2 -name '*.flexiarg' -printf '.' | head -c 5000 | wc -c"}

  {:source/id :work-item-documents
   :store "~/code/futon*/holes/{missions,excursions,tickets}/*.md"
   :schema/version :work-item-markdown/current
   :pin/method :content-sha256
   :retention :git
   :rebuild/role #{:input}
   :check "find ~/code/futon* -maxdepth 4 -path '*/holes/*' -name '*.md' -printf '.' | head -c 5000 | wc -c"}

  {:source/id :circus-gcc
   :store "http://localhost:7073/api/alpha/arxana/query"
   :schema/version {:clusion/type-revisions [[:pattern/proposal 1] [:interpretation 1] [:pattern/occurrence 1] [:memory/recall 1] [:memory/use 1] [:memory/burial 1] [:memory/repetition 1] [:workplan/mention 2] [:hou/focus 1] [:hou/focus-relation 1] [:needs 1] [:supersedes 1]]}
   :pin/method :clusion-id
   :retention :durable
   :rebuild/role #{:derived}
   :check "curl -sS --max-time 5 -H 'content-type: application/edn' --data '{:query/type :role-reverse :endpoint-id \"inventory-check-none\" :limit 1}' http://localhost:7073/api/alpha/arxana/query"}

  {:source/id :migrated-memories-7093
   :store "http://localhost:7073/api/alpha/evidence (migrated from retired :7093)"
   :schema/version :memory/current
   :pin/method :memory-id-and-revision
   :retention :durable
   :rebuild/role #{:input :non-recomputable}
   :check "curl -sS --max-time 5 'http://localhost:7073/api/alpha/evidence?type=memory&limit=1'"}

  {:source/id :migrated-workplan-judgements-7094
   :store "http://localhost:7073/api/alpha/arxana/query (migrated from retired :7094)"
   :schema/version :workplan/entity-backlinks-current
   :pin/method :record-id
   :retention :durable
   :rebuild/role #{:input :non-recomputable}
   :check "curl -sS --max-time 5 -H 'content-type: application/edn' --data '{:query/type :role-reverse :endpoint-id \"inventory-check-none\" :limit 1}' http://localhost:7073/api/alpha/arxana/query"}

  {:source/id :giraffe-readings
   :store "~/notes/wm-next/giraffe-reads-2026-11-04/corpus"
   :schema/version 1
   :pin/method :generation-id-and-source-sha256
   :retention :immutable-generation
   :rebuild/role #{:derived}
   :check "find ~/notes/wm-next/giraffe-reads-2026-11-04/corpus -maxdepth 1 -type f -printf '.' | head -c 5000 | wc -c"}

  {:source/id :giraffe-reread-queue
   :store "~/.local/state/futon3c/giraffe-reread/requests.sqlite"
   :schema/version 1
   :pin/method :request-id-and-source-sha256
   :retention :retained-failures
   :rebuild/role #{:derived :non-recomputable}
   :check "python3 -c 'import os,sqlite3; p=os.path.expanduser(\"~/.local/state/futon3c/giraffe-reread/requests.sqlite\"); db=sqlite3.connect(\"file:\"+p+\"?mode=ro\",uri=True); print(db.execute(\"select count(*) from reread_requests\").fetchone()[0])'"}

  {:source/id :giraffe-products
   :store "~/code/storage/giraffe/<run-id>"
   :schema/version :manifest/current
   :pin/method :manifest-generation-id-git-sha-and-file-sha256
   :retention :immutable-run-directory
   :rebuild/role #{:derived}
   :check "find ~/code/storage/giraffe -mindepth 1 -maxdepth 1 -type d -printf '.' | head -c 5000 | wc -c"}]}
